{
  "files.hotExit": "onExit",
  "shellcheck.ignoreFileSchemes": [
    "git",
    "gitfs"
  ],
  "shellformat.useEditorConfig": true,
  "shellformat.path": "/usr/bin/shfmt",
  "shellformat.effectLanguages": [
    "shell",
    "shellscript",
    "dockerfile",
    "dotenv",
    "hosts",
    "jvmoptions",
    "ignore",
    "gitignore",
    "properties",
    "spring-boot-properties",
    "azcli",
    "bats"
  ]
}
